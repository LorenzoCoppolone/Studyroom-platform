# ------------------------------------------------------------------
# StudyRoom Platform - template variabili d'ambiente
# Copiare in `.env` e valorizzare. NON committare il file `.env`.
# ------------------------------------------------------------------

# Ambiente
# APP_DEBUG=false in produzione: niente stack trace all'utente,
# Doctrine non in dev mode, Smarty non ricompila a ogni richiesta.
APP_DEBUG=false
# URL base pubblico = radice del sito (no slash finale, no sottocartella):
# l'app usa path assoluti tipo /User/..., quindi APP_URL deve puntare alla
# root del virtual host (es. https://Studyroom-platform.test), non a una subdir.
APP_URL=https://example.com

# Database (in alternativa si puo' usare DATABASE_URL)
DB_NAME=StudyRoom
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# DATABASE_URL=mysql://user:pass@host:3306/StudyRoom

# Email (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Valori accettati: tls | ssl | none
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="StudyRoom"
