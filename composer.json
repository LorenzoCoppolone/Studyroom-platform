{
    "name": "studyroom/project",
    "description": "Progetto universitario StudyRoom",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "doctrine/orm": "^3.6.3",
        "vlucas/phpdotenv": "^5.6",
        "symfony/cache": "^7.4",
        "symfony/var-exporter": "^7.0",
        "smarty/smarty": "^5.8",
        "phpmailer/phpmailer": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Model\\": "src/Model/",
            "Controller\\": "src/Controller/",
            "Foundation\\": "src/Foundation/",
            "UI\\": "src/UI/",
            "config\\": "config/"
        }
    },
    "require-dev": {
        "doctrine/migrations": "^3.9",
        "code-lts/doctum": "^5.6"
    }
}
